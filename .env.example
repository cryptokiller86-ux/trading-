# ── Telegram ──────────────────────────────────────────────────────────────────
# Get your API credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Your Telegram phone number (international format)
TELEGRAM_PHONE=+33612345678

# Session file name (leave default)
TELEGRAM_SESSION=yasso_session

# Group username (without @) or full invite link
TELEGRAM_GROUP=TheYassoGroup

# ── MetaTrader 5 (PUPrime) ────────────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=YourMT5Password
MT5_SERVER=PUPrime-Live

# Full path to terminal64.exe — leave empty for auto-detect
# MT5_PATH=C:\Program Files\PUPrime MetaTrader 5\terminal64.exe

# ── Trade parameters ──────────────────────────────────────────────────────────
# Fixed lot size used when USE_RISK_PERCENT=false
DEFAULT_LOT_SIZE=0.01

# Maximum lot size cap
MAX_LOT_SIZE=1.0

# Slippage in points
SLIPPAGE=10

# Magic number to identify bot trades in MT5
MAGIC_NUMBER=20250510

# How many TPs to open (1 = only TP1, 0 = all TPs as separate positions)
MAX_TP_COUNT=1

# ── Risk management ───────────────────────────────────────────────────────────
# Set to true to auto-calculate lot size based on risk % of balance
USE_RISK_PERCENT=false

# Risk per trade as % of account balance (used when USE_RISK_PERCENT=true)
RISK_PERCENT=1.0
